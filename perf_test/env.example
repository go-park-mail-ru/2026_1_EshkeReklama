# Скопируйте в perf_test/.env и заполните перед запуском тестов.
# cp perf_test/env.example perf_test/.env

# URL сервиса без завершающего слэша
BASE_URL=https://your-vm.example.com

# Рекламодатель для создания объявлений
ADVERTISER_EMAIL=info@romashka.ru
ADVERTISER_PASSWORD=password

# Сессия админа для чтения GET /api/admin/ads/{id}
# (рекламодатель с role=admin, см. README)
ADMIN_SESSION_ID=

# Заполняются скриптом setup.sh:
# CSRF_TOKEN=
# SESSION_ID=
# CAMPAIGN_ID=
# GROUP_ID=

# Префикс title для последующей очистки
LOADTEST_PREFIX=LOADTEST_

# wrk: потоки / соединения / длительность
WRK_THREADS=8
WRK_CONNECTIONS=200
WRK_DURATION_CREATE=30m
WRK_DURATION_READ=60s

# Диапазон id объявлений для read-теста (после create, из БД или state)
READ_MIN_AD_ID=1
READ_MAX_AD_ID=100000

# PostgreSQL (имя базы на сервере — db; схема таблиц — eshkere)
PGHOST=127.0.0.1
PGDATABASE=db
PGUSER=postgres
PGPASSWORD=
